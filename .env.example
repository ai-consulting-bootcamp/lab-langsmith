# API credentials
OPENAI_API_KEY=
LANGSMITH_API_KEY=

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=intellectus-operations-cx-evaluation

# Use the EU endpoint for an EU-hosted LangSmith workspace.
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Optional: required only when the API key can access multiple workspaces.
LANGSMITH_WORKSPACE_ID=

# Target model used by src/target.py.
TARGET_MODEL=gpt-5.4-mini
JUDGE_MODEL=gpt-5.4
