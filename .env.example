# Required for the real hosted evaluation
LANGSMITH_API_KEY=lsv2_your_key_here
OPENAI_API_KEY=sk-your_key_here

# LangSmith tracing configuration
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ironhack-ticket-priority-evaluation
# Set this only if your API key belongs to more than one workspace.
LANGSMITH_WORKSPACE_ID=

# Optional overrides
OPENAI_MODEL=gpt-5.6-luna
LANGSMITH_DATASET_NAME=ironhack-support-ticket-priority-v1
LANGSMITH_EXPERIMENT_PREFIX=ticket-priority-gpt-5.6-luna
